{
  "expo": {
    "name": "RxEx Driver",
    "slug": "rxex-driver",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "scheme": "rxexdriver",
    "userInterfaceStyle": "light",
    "icon": "./assets/app-icon-clean.png",
    "splash": {
      "image": "./assets/app-icon-clean.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5FAFB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rxexpresss.driver",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is required to scan package QR codes and capture proof of delivery photos.",
        "NSLocationWhenInUseUsageDescription": "Location is required while using the app to track active delivery progress and confirm delivery coordinates."
      }
    },
    "android": {
      "package": "com.rxexpresss.driver",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-clean.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RxEx Driver to scan package QR codes and capture proof of delivery photos.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow RxEx Driver to access your location while using the app for delivery progress and proof of delivery."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "https://backend.rxexpresss.com/api",
      "router": {},
      "eas": {
        "projectId": "9d0c215d-ed12-4de6-a878-0b415a0aaf84"
      }
    },
    "owner": "geo6991"
  }
}
